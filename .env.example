# Génie Solutions — exemple de configuration. COPIER vers ../genie-solutions.env (HORS de la racine
# web, recommandé) ou à défaut vers .env (jamais committé). Variable GS_ENV_FILE = chemin explicite.
# Ce fichier ne doit contenir AUCUN secret réel.

APP_ENV=local            # local | production
APP_DEBUG=false          # true uniquement en local
APP_URL=http://genie-solutions.test
# Sel servant à hacher les adresses IP (générer : php -r "echo bin2hex(random_bytes(32));")
APP_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=genie_solutions
DB_USER=genie_app        # compte à privilèges minimaux (SELECT, INSERT, UPDATE, DELETE)
DB_PASS=

# Envoi des e-mails (SMTP). Laisser MAIL_HOST vide désactive l'envoi.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls      # tls | ssl | none
MAIL_USER=
MAIL_PASS=
MAIL_VERIFY_PEER=true    # false uniquement en test local avec un certificat auto-signé

# Délai minimal (secondes) entre l'affichage et l'envoi d'un formulaire public (anti-robots)
FORM_MIN_SECONDS=3
