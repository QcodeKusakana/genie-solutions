# Aucun script exécutable dans le dossier des téléversements publics.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php[0-9s]?|phtml|phar|pl|py|cgi|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>
# Seules les images raster sont servies.
<FilesMatch "\.(jpe?g|png|webp|gif|avif)$">
    Require all granted
</FilesMatch>
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|webp|gif|avif)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>
